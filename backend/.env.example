PORT=
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=bidlive
JWT_SECRET=
JWT_EXPIRES_IN=1d
CORS_ORIGIN=
# Frontend server defaults to 127.0.0.1:5500 for local development.
FRONTEND_HOST=
FRONTEND_PORT=
# Optional absolute API URL ending in /api; used to configure all browser pages.
BIDLIVE_API_BASE=
# Comma-separated exact frontend origins; wildcard (*) is not supported.
# In production, configure only the deployed frontend origin(s).
# Authentication requests: 20 per IP per 15 minutes; bid requests: 60 per IP per 15 minutes.
# JSON request bodies are limited to 100 KB.
# Optional values used only by `npm run seed`; choose your own credentials.
SEED_BUYER_NAME=BidLive Test Buyer
SEED_BUYER_EMAIL=
SEED_BUYER_PASSWORD=
SEED_SELLER_NAME=BidLive Test Seller
SEED_SELLER_EMAIL=
SEED_SELLER_PASSWORD=
